# Local development values only. Copy to docker/.env to override them; never commit .env.
# Every variable has the same default in docker-compose.yaml, so the stack also starts without this file.

POSTGRES_PASSWORD=postgres
CLIENTE_DB_OWNER_PASSWORD=cliente_owner
CLIENTE_DB_APP_PASSWORD=cliente_app
CUENTA_DB_OWNER_PASSWORD=cuenta_owner
CUENTA_DB_APP_PASSWORD=cuenta_app

# "demo" seeds the clients and accounts of the exercise; empty starts with no data.
LIQUIBASE_CONTEXTS=demo

# Host ports.
CLIENTE_SERVICE_PORT=8081
CUENTA_SERVICE_PORT=8082
POSTGRES_PORT=5432
KAFKA_PORT=9092
VALKEY_PORT=6379
GRAFANA_PORT=3000
